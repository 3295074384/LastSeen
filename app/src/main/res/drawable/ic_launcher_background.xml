<?xml version="1.0" encoding="utf-8"?>
<!--
    LastSeen launcher icon — background layer.
    Blue linear gradient matching logo.svg bgGrad.
    Top: #3AC5FA  →  Bottom: #0E5CAD
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item
                    android:color="#FF3AC5FA"
                    android:offset="0.0" />
                <item
                    android:color="#FF0E5CAD"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
